<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="我的信息"
            android:textColor="@color/blue_700"
            android:textSize="23sp"
            android:textStyle="bold"
            android:paddingHorizontal="15dp"
            android:paddingTop="15dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="13dp">

            <!-- 紧凑横版名片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_profile_card"
                android:elevation="4dp"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/white"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvClassChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_profile_chip"
                        android:maxWidth="175dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="—"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:paddingHorizontal="11dp"
                        android:paddingVertical="3dp" />

                    <TextView
                        android:id="@+id/tvSnoSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="学号 —"
                        android:textColor="#DCEEF9"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 信息卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="11dp">
                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile_yellow"
                        android:gravity="center"
                        android:text="🎓"
                        android:textSize="19sp" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="学号"
                        android:textSize="13sp"
                        android:textColor="#7C8FA0"
                        android:layout_marginStart="12dp" />
                    <TextView
                        android:id="@+id/tvValSno"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:gravity="end"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F0F5F9" android:layout_marginHorizontal="15dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="11dp">
                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile_mint"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="19sp" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="姓名"
                        android:textSize="13sp"
                        android:textColor="#7C8FA0"
                        android:layout_marginStart="12dp" />
                    <TextView
                        android:id="@+id/tvValName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:gravity="end"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F0F5F9" android:layout_marginHorizontal="15dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="11dp">
                    <TextView
                        android:id="@+id/tvSexIcon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile_lav"
                        android:gravity="center"
                        android:text="♀"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#9B59B6" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="性别"
                        android:textSize="13sp"
                        android:textColor="#7C8FA0"
                        android:layout_marginStart="12dp" />
                    <TextView
                        android:id="@+id/tvValSex"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:gravity="end"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F0F5F9" android:layout_marginHorizontal="15dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="11dp">
                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile_peach"
                        android:gravity="center"
                        android:text="🎂"
                        android:textSize="19sp" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="年龄"
                        android:textSize="13sp"
                        android:textColor="#7C8FA0"
                        android:layout_marginStart="12dp" />
                    <TextView
                        android:id="@+id/tvValAge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:gravity="end"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F0F5F9" android:layout_marginHorizontal="15dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="11dp">
                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile_green"
                        android:gravity="center"
                        android:text="🏫"
                        android:textSize="19sp" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="班级"
                        android:textSize="13sp"
                        android:textColor="#7C8FA0"
                        android:layout_marginStart="12dp" />
                    <TextView
                        android:id="@+id/tvValDept"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:gravity="end"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#F0F5F9" android:layout_marginHorizontal="15dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="11dp">
                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_tile_blue"
                        android:gravity="center"
                        android:text="📱"
                        android:textSize="19sp" />
                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:text="手机"
                        android:textSize="13sp"
                        android:textColor="#7C8FA0"
                        android:layout_marginStart="12dp" />
                    <TextView
                        android:id="@+id/tvValPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:gravity="end"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                </LinearLayout>
            </LinearLayout>

            <!-- 底部提示条 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_info_bar"
                android:padding="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ⓘ"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#3E9BD6" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="信息有误，请联系老师修改"
                    android:textSize="13sp"
                    android:textColor="#4A6B80"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
