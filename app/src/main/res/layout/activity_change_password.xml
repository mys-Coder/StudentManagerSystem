<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="修改密码"
            android:textColor="@color/blue_700"
            android:textSize="23sp"
            android:textStyle="bold"
            android:paddingHorizontal="15dp"
            android:paddingTop="15dp"
            android:paddingBottom="13dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="13dp">

            <!-- 安全头卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_safe_head"
                android:padding="15dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_icon_blue"
                    android:gravity="center"
                    android:text="🔒"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="13dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="账号安全"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="定期修改密码可保护个人信息与成绩数据安全"
                        android:textSize="10.5sp"
                        android:textColor="@color/text_sub"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 表单卡 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="原密码"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4A6B80"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etOldPwd"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="请输入当前密码"
                        android:textColorHint="#9DB6C6"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:paddingHorizontal="13dp"
                        android:paddingEnd="44dp"
                        android:background="@drawable/bg_pwd_field" />

                    <TextView
                        android:id="@+id/eyeOld"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="👁"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="新密码（至少 6 位）"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4A6B80"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etNewPwd"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="请输入新密码"
                        android:textColorHint="#9DB6C6"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:paddingHorizontal="13dp"
                        android:paddingEnd="44dp"
                        android:background="@drawable/bg_pwd_field" />

                    <TextView
                        android:id="@+id/eyeNew"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="👁"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="确认新密码"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4A6B80"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etConfirmPwd"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:hint="请再次输入新密码"
                        android:textColorHint="#9DB6C6"
                        android:textColor="@color/text_main"
                        android:textSize="15sp"
                        android:inputType="textPassword"
                        android:paddingHorizontal="13dp"
                        android:paddingEnd="44dp"
                        android:background="@drawable/bg_pwd_field" />

                    <TextView
                        android:id="@+id/eyeConfirm"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:text="👁"
                        android:textSize="15sp"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>
            </LinearLayout>

            <!-- 保存按钮 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSavePwd"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="15dp"
                android:text="保存修改"
                android:background="@drawable/btn_save_pwd"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <!-- 修改须知 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="13dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 修改须知"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="· 新密码长度至少 6 位，两次输入需一致"
                    android:textSize="13sp"
                    android:textColor="@color/text_sub"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="· 新密码不能与原密码相同"
                    android:textSize="13sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="· 密码以 MD5 加密存储，修改成功后需重新登录"
                    android:textSize="13sp"
                    android:textColor="@color/text_sub"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
