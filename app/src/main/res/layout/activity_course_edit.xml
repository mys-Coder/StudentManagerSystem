<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="课程信息（带 * 为必填）"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:background="@drawable/bg_header"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:padding="16dp">

            <EditText
                android:id="@+id/etCno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="课程号 *（如 C004）"
                android:inputType="text"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search" />

            <EditText
                android:id="@+id/etCname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="课程名 *"
                android:inputType="text"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search" />

            <EditText
                android:id="@+id/etCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="学分 *（如 3.0）"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search" />

            <EditText
                android:id="@+id/etHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="学时 *（如 48）"
                android:inputType="number"
                android:padding="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_search" />

            <EditText
                android:id="@+id/etSemester"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="学期 *（如 2026-1）"
                android:inputType="text"
                android:padding="10dp"
                android:background="@drawable/bg_search" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveCourse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="保 存"
            android:background="@drawable/btn_green"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
