<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="课程管理"
        android:textColor="@color/blue_700"
        android:textSize="23sp"
        android:textStyle="bold"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="11dp" />

    <!-- 数据概览三格 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_metric_tile"
            android:paddingVertical="10dp">
            <TextView
                android:id="@+id/tvMTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/blue_600"
                android:text="0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="课程总数"
                android:textSize="9.5sp"
                android:textColor="@color/text_sub"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_metric_tile"
            android:paddingVertical="10dp">
            <TextView
                android:id="@+id/tvMCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/blue_600"
                android:text="0.0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="总学分"
                android:textSize="9.5sp"
                android:textColor="@color/text_sub"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_metric_tile"
            android:paddingVertical="10dp">
            <TextView
                android:id="@+id/tvMHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/blue_600"
                android:text="0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="总学时"
                android:textSize="9.5sp"
                android:textColor="@color/text_sub"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/etSearchCourse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:hint="🔍 搜索课程号 / 课程名 / 学期"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:padding="10dp"
        android:background="@drawable/bg_search"
        android:layout_marginBottom="9dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAddCourse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:text="＋ 新增课程"
        android:background="@drawable/btn_green"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:text="单击录入成绩 · 长按修改 / 删除 / 统计图表"
        android:textColor="@color/text_sub"
        android:textSize="10.5sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCourses"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无课程，点上方“＋ 新增课程”添加"
        android:textColor="@color/text_sub"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
